# Copy to .env and fill in. Providers whose key is empty are skipped.
# Never commit .env (it is in .gitignore). Step-by-step key instructions: README.md, "Get API keys".

# Key your tools (Continue, Roo Code, curl...) send as "Authorization: Bearer <key>".
# Not from any service: make one up. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_API_KEY=

# Provider keys. Set at least one; more keys means more free capacity to fail over to.
# Z.ai (GLM flash models, free):    https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Google AI Studio (Gemini):        https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (free ":free" models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# NVIDIA NIM (trial, prototyping):  https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Groq (free tier is only 8K tokens/min, so used for fast/json/vision, not smart):
# https://console.groq.com/keys
GROQ_API_KEY=

# Server
HOST=127.0.0.1
PORT=18181

# Logging: debug | info | warn | error. LOG_FILE also appends every log line to a file.
LOG_LEVEL=info
LOG_FILE=logs/gateway.log
